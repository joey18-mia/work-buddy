# ============================================================
#  WorkBuddy — Environment Variables
#  INSTRUCTIONS:
#    1. Copy this file:  cp .env.example .env
#    2. Fill in your real API keys in .env
#    3. Never share or commit your .env file
# ============================================================

# --- Weather ---
# Get your key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweathermap_key_here

# --- TomTom (Traffic + Routing) ---
# Get your key at: https://developer.tomtom.com/
TOMTOM_API_KEY=your_tomtom_key_here

# --- App Settings ---
# Change this to a long random string for session security
SECRET_KEY=change_this_to_a_long_random_string

# --- Location (set for weather + dashboard label) ---
LOCATION_LAT=
LOCATION_LON=
LOCATION_NAME=

# --- MLB schedule (optional) ---
# Comma-separated team IDs to highlight in the schedule UI (see MLB Stats API).
# Leave blank to list all games without a featured team.
# MLB_TRACKED_TEAM_ID=
